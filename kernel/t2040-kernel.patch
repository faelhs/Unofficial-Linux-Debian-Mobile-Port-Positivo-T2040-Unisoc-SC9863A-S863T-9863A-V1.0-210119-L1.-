+	dev_dbg(cm->dev, "%s, adp_max_ibus = %d, cp_max_ibus = %d, thm_cur = %d, target_ibus = %d\n",
+	       __func__, cp->adapter_max_ibus, cp->cp_max_ibus,
+	       cm->desc->thm_info.thm_adjust_cur, cp->cp_target_ibus);
