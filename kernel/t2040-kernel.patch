+/* T2040: backport de P_PIDFD (Linux 5.4) - resolve o pidfd para o struct pid */
+static struct pid *pidfd_get_pid(unsigned int fd)
+{
+	struct fd f;
+	struct pid *pid;
+
+	f = fdget(fd);
+	if (!f.file)
+		return ERR_PTR(-EBADF);
+
+	if (f.file->f_op == &pidfd_fops) {
+		pid = f.file->private_data;
+		get_pid(pid);
+	} else {
+		pid = ERR_PTR(-EBADF);
+	}
+
+	fdput(f);
+	return pid;
+}
